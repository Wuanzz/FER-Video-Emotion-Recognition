    "# CELL 7: Utility Vẽ Biểu đồ Matplotlib & Format HTML Dashboard Cards\n",
    "\n",
    "def create_probability_chart(probabilities_dict):\n",
    "    \"\"\"\n",
    "    Tạo biểu đồ thanh ngang cho 8 cảm xúc bằng Matplotlib với giao diện hiện đại.\n",
    "    \"\"\"\n",
    "    emotions_labels = [f\"{EMOTION_EMOJIS[e]} {EMOTIONS_VN_MAP[e]} ({e.capitalize()})\" for e in EMOTIONS_EN]\n",
    "    probs = [probabilities_dict[e] for e in EMOTIONS_EN]\n",
    "    max_idx = int(np.argmax(probs))\n",
    "\n",
    "    colors = ['#cbd5e1'] * len(probs)\n",
    "    colors[max_idx] = '#2563eb'  # Highlight màu xanh dương cho cảm xúc cao nhất\n",
    "\n",
    "    fig, ax = plt.subplots(figsize=(8, 4.5), dpi=100)\n",
    "    fig.patch.set_facecolor('#ffffff')\n",
    "    ax.set_facecolor('#f8fafc')\n",
    "\n",
    "    y_pos = np.arange(len(emotions_labels))\n",
    "    bars = ax.barh(y_pos, probs, color=colors, height=0.6, edgecolor='none')\n",
    "\n",
    "    ax.set_yticks(y_pos)\n",
    "    ax.set_yticklabels(emotions_labels, fontsize=11, fontweight='bold', color='#1e293b')\n",
    "    ax.invert_yaxis()\n",
    "    ax.set_xlabel('Xác suất (%)', fontsize=11, fontweight='bold', color='#475569')\n",
    "    ax.set_xlim(0, 100)\n",
    "    ax.grid(axis='x', linestyle='--', alpha=0.5, color='#94a3b8')\n",
    "\n",
    "    for i, (bar, prob) in enumerate(zip(bars, probs)):\n",
    "        width = bar.get_width()\n",
    "        font_weight = 'bold' if i == max_idx else 'normal'\n",
    "        font_color = '#1e3a8a' if i == max_idx else '#475569'\n",
    "        ax.text(width + 1.5, bar.get_y() + bar.get_height()/2, f\"{prob:.1f}%\",\n",
    "                va='center', ha='left', fontsize=10, fontweight=font_weight, color=font_color)\n",
    "\n",
    "    ax.spines['top'].set_visible(False)\n",
    "    ax.spines['right'].set_visible(False)\n",
    "    ax.spines['left'].set_color('#cbd5e1')\n",
    "    ax.spines['bottom'].set_color('#cbd5e1')\n",
    "\n",
    "    plt.title(\"Biểu đồ phân bố xác suất cảm xúc\", fontsize=13, fontweight='bold', color='#0f172a', pad=12)\n",
    "    plt.tight_layout()\n",
    "    return fig\n",
    "\n",
    "def generate_distribution_html(probabilities_dict):\n",
    "    \"\"\"\n",
    "    Tạo danh sách visual progress bars HTML cho 8 cảm xúc.\n",
    "    \"\"\"\n",
    "    max_emotion = max(probabilities_dict, key=probabilities_dict.get) if probabilities_dict else 'neutral'\n",
    "    \n",
    "    html = \"<div style='display: flex; flex-direction: column; gap: 8px; font-family: system-ui, sans-serif;'>\"\n",
    "    for emo in EMOTIONS_EN:\n",
    "        prob = probabilities_dict.get(emo, 0.0)\n",
    "        vn_name = EMOTIONS_VN_MAP[emo]\n",
    "        emoji = EMOTION_EMOJIS[emo]\n",
    "        is_top = (emo == max_emotion and prob > 0)\n",
    "        \n",
    "        bg_color = \"#2563eb\" if is_top else \"#94a3b8\"\n",
    "        label_weight = \"700\" if is_top else \"500\"\n",
    "        text_color = \"#0f172a\" if is_top else \"#334155\"\n",
    "        \n",
    "        html += f\"\"\"\n",
    "        <div style='display: flex; align-items: center; justify-content: space-between; font-size: 13px; color: {text_color};'>\n",
    "            <span style='width: 140px; font-weight: {label_weight};'>{emoji} {vn_name} <span style='font-size: 11px; color: #64748b;'>({emo})</span></span>\n",
    "            <div style='flex-grow: 1; background-color: #f1f5f9; height: 10px; border-radius: 5px; margin: 0 12px; overflow: hidden;'>\n",
    "                <div style='background-color: {bg_color}; width: {prob}%; height: 100%; border-radius: 5px; transition: width 0.4s ease;'></div>\n",
    "            </div>\n",
    "            <span style='width: 50px; text-align: right; font-weight: {label_weight};'>{prob:.1f}%</span>\n",
    "        </div>\n",
    "        \"\"\"\n",
    "    html += \"</div>\"\n",
    "    return html\n",
    "\n",
    "def generate_frame_table_html(frame_info_list):\n",
    "    \"\"\"\n",
    "    Tạo bảng HTML mô tả trạng thái 16 frames.\n",
    "    \"\"\"\n",
    "    html = \"\"\"\n",
    "    <div style='max-height: 220px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 8px;'>\n",
    "    <table style='width: 100%; border-collapse: collapse; font-size: 12px; font-family: system-ui, sans-serif; text-align: left;'>\n",
    "        <thead style='background-color: #f8fafc; position: sticky; top: 0; z-index: 1;'>\n",
    "            <tr style='border-bottom: 2px solid #e2e8f0; color: #475569;'>\n",
    "                <th style='padding: 6px 10px;'>Frame</th>\n",
    "                <th style='padding: 6px 10px;'>Thời điểm</th>\n",
    "                <th style='padding: 6px 10px;'>Face Detection</th>\n",
    "                <th style='padding: 6px 10px;'>Bounding Box</th>\n",
    "            </tr>\n",
    "        </thead>\n",
    "        <tbody>\n",
    "    \"\"\"\n",
    "    for item in frame_info_list:\n",
    "        status_badge = \"<span style='background:#dcfce7; color:#15803d; padding:2px 8px; border-radius:12px; font-weight:600;'>Detected</span>\" if item['face_detected'] else \"<span style='background:#fee2e2; color:#b91c1c; padding:2px 8px; border-radius:12px; font-weight:600;'>Full Frame</span>\"\n",
    "        html += f\"\"\"\n",
    "        <tr style='border-bottom: 1px solid #f1f5f9;'>\n",
    "            <td style='padding: 6px 10px; font-weight: 600;'>#{item['frame_num']}</td>\n",
    "            <td style='padding: 6px 10px;'>{item['timestamp_sec']}s</td>\n",
    "            <td style='padding: 6px 10px;'>{status_badge}</td>\n",
    "            <td style='padding: 6px 10px; font-family: monospace; color: #64748b;'>{item.get('box_str', 'N/A')}</td>\n",
    "        </tr>\n",
    "        \"\"\"\n",
    "    html += \"</tbody></table></div>\"\n",
    "    return html"
   ]
