    "# CELL 3: Cấu hình Hệ thống & Ánh xạ Nhãn Cảm xúc\n",
    "DEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "IMAGE_SIZE = (224, 224)\n",
    "SEQUENCE_LENGTH = 16\n",
    "\n",
    "# Ánh xạ 8 nhãn cảm xúc RAVDESS gốc của nhóm (1-indexed)\n",
    "EMOTION_MAP = {\n",
    "    1: 'neutral',\n",
    "    2: 'calm',\n",
    "    3: 'happy',\n",
    "    4: 'sad',\n",
    "    5: 'angry',\n",
    "    6: 'fearful',\n",
    "    7: 'disgust',\n",
    "    8: 'surprised'\n",
    "}\n",
    "\n",
    "# Danh sách 8 emotion chuẩn (0-indexed tương ứng output tensor [0-7])\n",
    "EMOTIONS_EN = ['neutral', 'calm', 'happy', 'sad', 'angry', 'fearful', 'disgust', 'surprised']\n",
    "\n",
    "# Mapping hiển thị tiếng Việt\n",
    "EMOTIONS_VN_MAP = {\n",
    "    'neutral': 'Bình thường',\n",
    "    'calm': 'Bình tĩnh',\n",
    "    'happy': 'Vui vẻ',\n",
    "    'sad': 'Buồn',\n",
    "    'angry': 'Tức giận',\n",
    "    'fearful': 'Sợ hãi',\n",
    "    'disgust': 'Ghê tởm',\n",
    "    'surprised': 'Ngạc nhiên'\n",
    "}\n",
    "\n",
    "# Emoji đại diện từng cảm xúc\n",
    "EMOTION_EMOJIS = {\n",
    "    'neutral': '😐',\n",
    "    'calm': '😌',\n",
    "    'happy': '😊',\n",
    "    'sad': '😢',\n",
    "    'angry': '😡',\n",
    "    'fearful': '😨',\n",
    "    'disgust': '🤢',\n",
    "    'surprised': '😲'\n",
    "}\n",
    "\n",
    "print(f\"Device: {DEVICE}\")\n",
    "print(f\"Sequence Length: {SEQUENCE_LENGTH}, Image Size: {IMAGE_SIZE}\")\n",
    "print(f\"Số lượng cảm xúc: {len(EMOTIONS_EN)}\")"
   ]
