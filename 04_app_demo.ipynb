    "# CELL 5: Khởi tạo & Load Checkpoint best_model.pth\n",
    "# Kiểm tra an toàn sự tồn tại của file checkpoint thật\n",
    "\n",
    "def load_fer_model():\n",
    "    candidate_paths = [\n",
    "        \"best_model.pth\",\n",
    "        \"checkpoints/best_model.pth\",\n",
    "        \"models/best_model.pth\",\n",
    "        \"../checkpoints/best_model.pth\",\n",
    "        \"./Project_FER_Video/checkpoints/best_model.pth\",\n",
    "        \"FER-Video-Emotion-Recognition-main/checkpoints/best_model.pth\",\n",
    "        \"FER-Video-Emotion-Recognition-main/best_model.pth\"\n",
    "    ]\n",
    "\n",
    "    found_path = None\n",
    "    for p in candidate_paths:\n",
    "        if os.path.exists(p):\n",
    "            found_path = p\n",
    "            break\n",
    "\n",
    "    if found_path is None:\n",
    "        err_msg = (\n",
    "            \"⚠️ KHÔNG TÌM THẤY CHECKPOINT `best_model.pth`!\\n\\n\"\n",
    "            \"Vui lòng copy file `best_model.pth` vào thư mục gốc của dự án hoặc thư mục `checkpoints/best_model.pth`.\\n\"\n",
    "        )\n",
    "        print(err_msg)\n",
    "        return None, None, err_msg, None\n",
    "\n",
    "    print(f\"Tìm thấy checkpoint tại: {found_path}\")\n",
    "    try:\n",
    "        checkpoint = torch.load(found_path, map_location=DEVICE)\n",
    "        config = checkpoint.get('config', {\n",
    "            'backbone': 'resnet18',\n",
    "            'rnn_type': 'LSTM',\n",
    "            'hidden_dim': 256,\n",
    "            'num_rnn_layers': 2,\n",
    "            'dropout': 0.5,\n",
    "            'num_classes': 8\n",
    "        })\n",
    "\n",
    "        model = SpatialTemporalFERModel(\n",
    "            backbone_name=config.get('backbone', 'resnet18'),\n",
    "            rnn_type=config.get('rnn_type', 'LSTM'),\n",
    "            hidden_dim=config.get('hidden_dim', 256),\n",
    "            num_rnn_layers=config.get('num_rnn_layers', 2),\n",
    "            dropout=config.get('dropout', 0.5),\n",
    "            num_classes=config.get('num_classes', 8)\n",
    "        )\n",
    "\n",
    "        model.load_state_dict(checkpoint['model_state_dict'])\n",
    "        model.to(DEVICE)\n",
    "        model.eval()\n",
    "\n",
    "        val_acc = checkpoint.get('val_acc', None)\n",
    "        epoch = checkpoint.get('epoch', None)\n",
    "        status = f\"✅ Loaded model weights from '{found_path}' successfully.\"\n",
    "        if val_acc is not None:\n",
    "            status += f\" (Val Acc: {val_acc*100:.2f}%, Epoch: {epoch})\"\n",
    "        print(status)\n",
    "        return model, config, None, found_path\n",
    "    except Exception as e:\n",
    "        err_msg = f\"❌ Lỗi khi tải state_dict: {str(e)}\"\n",
    "        print(err_msg)\n",
    "        return None, None, err_msg, found_path\n",
    "\n",
    "# Load Model 1 lần duy nhất khi khởi tạo Notebook\n",
    "MODEL, MODEL_CONFIG, LOAD_ERROR, MODEL_PATH_USED = load_fer_model()\n",
    "MODEL_LOADED = (MODEL is not None)"
   ]
