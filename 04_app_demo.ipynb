    "# CELL 8: Hàm xử lý chính Inference & Generator Cập nhật Real-Time UI\n",
    "\n",
    "def analyze_video_pipeline(video_path):\n",
    "    \"\"\"\n",
    "    Gradio Generator pipeline cập nhật trạng thái UI theo thời gian thực.\n",
    "    \"\"\"\n",
    "    # 1. Kiểm tra video đầu vào\n",
    "    if video_path is None:\n",
    "        yield (\n",
    "            \"<span class='status-badge badge-error'>❌ THIẾU VIDEO</span>\",\n",
    "            \"### ❌ Vui lòng tải lên một video ngắn (MP4 / AVI / MOV)!\",\n",
    "            generate_distribution_html({e: 0.0 for e in EMOTIONS_EN}),\n",
    "            \"<p style='color:#ef4444; font-weight:600;'>Chưa có video được chọn.</p>\",\n",
    "            None,\n",
    "            \"Chưa có dữ liệu thống kê.\",\n",
    "            \"Chưa có dữ liệu khung hình.\"\n",
    "        )\n",
    "        return\n",
    "\n",
    "    # 2. Kiểm tra trạng thái Checkpoint Model\n",
    "    if not MODEL_LOADED:\n",
    "        yield (\n",
    "            \"<span class='status-badge badge-error'>❌ LỖI MODEL</span>\",\n",
    "            f\"### ❌ Không thể chạy inference vì thiếu Checkpoint!\\n\\n{LOAD_ERROR}\",\n",
    "            generate_distribution_html({e: 0.0 for e in EMOTIONS_EN}),\n",
    "            f\"<p style='color:#ef4444; font-weight:600;'>❌ Model chưa được load: {LOAD_ERROR}</p>\",\n",
    "            None,\n",
    "            \"Lỗi Checkpoint Model.\",\n",
    "            \"Không thể phân tích frame.\"\n",
    "        )\n",
    "        return\n",
    "\n",
    "    start_time = time.time()\n",
    "\n",
    "    # Step 1: Processing Status\n",
    "    yield (\n",
    "        \"<span class='status-badge badge-processing'>⏳ PROCESSING</span>\",\n",
    "        \"### ⏳ Đang đọc video và trích xuất 16 khung hình...\",
    "        generate_distribution_html({e: 0.0 for e in EMOTIONS_EN}),\n",
    "        \"<p style='color:#2563eb;'>1. Đang mở file video và khởi tạo Haar Cascade face detector...</p>\",\n",
    "        None,\n",
    "        \"Đang tính toán...\",\n",
    "        \"Đang trích xuất khung hình...\"\n",
    "    )\n",
    "\n",
    "    # Step 2: Preprocessing Video\n",
    "    try:\n",
    "        video_tensor, raw_frames, frame_info_list, meta = extract_and_preprocess_video(\n",
    "            video_path,\n",
    "            sequence_length=SEQUENCE_LENGTH,\n",
    "            image_size=IMAGE_SIZE\n",
    "        )\n",
    "    except Exception as e:\n",
    "        yield (\n",
    "            \"<span class='status-badge badge-error'>❌ LỖI PREPROCESSING</span>\",\n",
    "            f\"### ❌ Lỗi khi xử lý Video:\\n`{str(e)}`\",\n",
    "            generate_distribution_html({e: 0.0 for e in EMOTIONS_EN}),\n",
    "            f\"<p style='color:#ef4444;'>❌ Preprocessing failed: {str(e)}</p>\",\n",
    "            None,\n",
    "            \"Lỗi Preprocessing.\",\n",
    "            \"Không thể trích xuất khung hình.\"\n",
    "        )\n",
    "        return\n",
    "\n",
    "    yield (\n",
    "        \"<span class='status-badge badge-processing'>⏳ INFERENCING</span>\",\n",
    "        \"### ⏳ Trích xuất thành công 16 frames! Đang đưa vào mô hình CNN + LSTM...\",
    "        generate_distribution_html({e: 0.0 for e in EMOTIONS_EN}),\n",
    "        f\"<p style='color:#2563eb;'>2. Trích xuất thành công 16 frames ({meta['face_detection_rate']}% detect khuôn mặt). Đang tính toán Softmax probabilities...</p>\",\n",
    "        None,\n",
    "        \"Đang chạy inference...\",\n",
    "        generate_frame_table_html(frame_info_list)\n",
    "    )\n",
    "\n",
    "    # Step 3: Model Inference & Softmax\n",
    "    try:\n",
    "        video_tensor = video_tensor.to(DEVICE)\n",
    "        with torch.inference_mode():\n",
    "            logits = MODEL(video_tensor)\n",
    "            probs = F.softmax(logits, dim=1).squeeze(0).cpu().numpy()\n",
    "\n",
    "        inference_time = round(time.time() - start_time, 3)\n",
    "\n",
    "        # Dictionary xác suất 8 cảm xúc\n",
    "        prob_dict = {EMOTIONS_EN[i]: float(probs[i] * 100) for i in range(len(EMOTIONS_EN))}\n",
    "        \n",
    "        top_idx = int(np.argmax(probs))\n",
    "        top_emotion_en = EMOTIONS_EN[top_idx]\n",
    "        top_emotion_vn = EMOTIONS_VN_MAP[top_emotion_en]\n",
    "        top_emoji = EMOTION_EMOJIS[top_emotion_en]\n",
    "        top_confidence = float(probs[top_idx] * 100)\n",
    "\n",
    "        # Layout hiển thị kết quả chính\n",
    "        main_result_markdown = f\"\"\"\n",
    "        <div style='text-align: center; padding: 16px; background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%); border-radius: 12px; border: 1px solid #bfdbfe;'>\n",
    "            <div style='font-size: 48px; margin-bottom: 4px;'>{top_emoji}</div>\n",
    "            <div style='font-size: 28px; font-weight: 800; color: #1e3a8a; text-transform: uppercase;'>{top_emotion_en}</div>\n",
    "            <div style='font-size: 20px; font-weight: 600; color: #2563eb; margin-bottom: 8px;'>{top_emotion_vn}</div>\n",
    "            <div style='display: inline-block; background-color: #2563eb; color: #ffffff; padding: 4px 16px; border-radius: 20px; font-weight: 700; font-size: 16px;'>\n",
    "                Confidence: {top_confidence:.1f}%\n",
    "            </div>\n",
    "        </div>\n",
    "        \"\"\"\n",
    "\n",
    "        # Card Thống kê chi tiết\n",
    "        stats_html = f\"\"\"\n",
    "        <div style='display: flex; flex-direction: column; gap: 8px; font-size: 13px; font-family: system-ui, sans-serif;'>\n",
    "            <div style='display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding-bottom: 4px;'>\n",
    "                <span style='color: #64748b;'>Cảm xúc dự đoán:</span>\n",
    "                <span style='font-weight: 700; color: #1e293b;'>{top_emoji} {top_emotion_vn} ({top_emotion_en.capitalize()})</span>\n",
    "            </div>\n",
    "            <div style='display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding-bottom: 4px;'>\n",
    "                <span style='color: #64748b;'>Độ tin cậy (Confidence):</span>\n",
    "                <span style='font-weight: 700; color: #2563eb;'>{top_confidence:.2f}%</span>\n",
    "            </div>\n",
    "            <div style='display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding-bottom: 4px;'>\n",
    "                <span style='color: #64748b;'>Số frames trích xuất:</span>\n",
    "                <span style='font-weight: 600; color: #0f172a;'>16 / 16 frames</span>\n",
    "            </div>\n",
    "            <div style='display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding-bottom: 4px;'>\n",
    "                <span style='color: #64748b;'>Tỉ lệ detect khuôn mặt:</span>\n",
    "                <span style='font-weight: 600; color: #0f172a;'>{meta['faces_detected_count']}/16 ({meta['face_detection_rate']}%)</span>\n",
    "            </div>\n",
    "            <div style='display: flex; justify-content: space-between; border-bottom: 1px solid #f1f5f9; padding-bottom: 4px;'>\n",
    "                <span style='color: #64748b;'>Thời gian xử lý:</span>\n",
    "                <span style='font-weight: 600; color: #0f172a;'>{inference_time} giây</span>\n",
    "            </div>\n",
    "            <div style='display: flex; justify-content: space-between;'>\n",
    "                <span style='color: #64748b;'>Thiết bị tính toán:</span>\n",
    "                <span style='font-weight: 600; color: #0f172a;'>{str(DEVICE).upper()}</span>\n",
    "            </div>\n",
    "        </div>\n",
    "        \"\"\"\n",
    "\n",
    "        chart_fig = create_probability_chart(prob_dict)\n",
    "        dist_html = generate_distribution_html(prob_dict)\n",
    "        frame_table_html = generate_frame_table_html(frame_info_list)\n",
    "\n",
    "        yield (\n",
    "            \"<span class='status-badge badge-completed'>✅ COMPLETED</span>\",\n",
    "            main_result_markdown,\n",
    "            dist_html,\n",
    "            f\"<p style='color:#16a34a; font-weight:600;'>✅ Phân tích hoàn tất thành công trong {inference_time}s!</p>\",\n",
    "            chart_fig,\n",
    "            stats_html,\n",
    "            frame_table_html\n",
    "        )\n",
    "\n",
    "    except Exception as e:\n",
    "        yield (\n",
    "            \"<span class='status-badge badge-error'>❌ LỖI INFERENCE</span>\",\n",
    "            f\"### ❌ Lỗi trong quá trình suy luận Model:\\n`{str(e)}`\",\n",
    "            generate_distribution_html({e: 0.0 for e in EMOTIONS_EN}),\n",
    "            f\"<p style='color:#ef4444;'>❌ Inference failed: {str(e)}</p>\",\n",
    "            None,\n",
    "            \"Lỗi tính toán Model.\",\n",
    "            \"Không thể hiển thị thông tin frame.\"\n",
    "        )"
   ]
