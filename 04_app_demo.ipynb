    "# CELL 6: Video Preprocessing Engine (Reused from data_preprocessing.ipynb)\n",
    "\n",
    "# Khởi tạo Haar Cascade Face Detector chuẩn của OpenCV\n",
    "cascade_path = cv2.data.haarcascades + 'haarcascade_frontalface_default.xml'\n",
    "face_cascade = cv2.CascadeClassifier(cascade_path)\n",
    "\n",
    "if face_cascade.empty():\n",
    "    print(\"⚠️ Cảnh báo: Không load được haarcascade_frontalface_default.xml gốc!\")\n",
    "\n",
    "# PyTorch ImageNet Transforms chuẩn mực\n",
    "val_transform = transforms.Compose([\n",
    "    transforms.ToPILImage(),\n",
    "    transforms.ToTensor(),\n",
    "    transforms.Normalize(\n",
    "        mean=[0.485, 0.456, 0.406],\n",
    "        std=[0.229, 0.224, 0.225]\n",
    "    )\n",
    "])\n",
    "\n",
    "def extract_and_preprocess_video(video_path, sequence_length=16, image_size=(224, 224)):\n",
    "    \"\"\"\n",
    "    Đọc video, lấy 16 frame phân bố đều, detect mặt bằng Haar Cascade, crop, pad, resize 224x224, normalize ImageNet.\n",
    "    Trả về:\n",
    "      - video_tensor: Tensor (1, 16, 3, 224, 224)\n",
    "      - raw_frames: np.ndarray (16, 224, 224, 3) RGB uint8\n",
    "      - frame_info_list: Danh sách metadata thông tin detect từng frame\n",
    "      - meta: dict thống kê tổng hợp\n",
    "    \"\"\"\n",
    "    if not os.path.exists(video_path):\n",
    "        raise FileNotFoundError(f\"File video không tồn tại: {video_path}\")\n",
    "\n",
    "    cap = cv2.VideoCapture(video_path)\n",
    "    if not cap.isOpened():\n",
    "        raise ValueError(f\"Không thể mở file video: {video_path}\")\n",
    "\n",
    "    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
    "    fps = cap.get(cv2.CAP_PROP_FPS)\n",
    "    if fps <= 0: fps = 30.0\n",
    "\n",
    "    if total_frames <= 0:\n",
    "        cap.release()\n",
    "        raise ValueError(\"Video không chứa khung hình hợp lệ.\")\n",
    "\n",
    "    # Lấy 16 frame phân bố đều (lin-space) như data_preprocessing.ipynb\n",
    "    frame_indices = np.linspace(0, total_frames - 1, sequence_length, dtype=int)\n",
    "\n",
    "    raw_frames = []\n",
    "    processed_tensors = []\n",
    "    frame_info_list = []\n",
    "    faces_detected_count = 0\n",
    "\n",
    "    for idx_num, frame_idx in enumerate(frame_indices):\n",
    "        cap.set(cv2.CAP_PROP_POS_FRAMES, int(frame_idx))\n",
    "        success, frame = cap.read()\n",
    "\n",
    "        if not success or frame is None:\n",
    "            if len(raw_frames) > 0:\n",
    "                raw_frames.append(raw_frames[-1].copy())\n",
    "                processed_tensors.append(processed_tensors[-1])\n",
    "                frame_info_list.append({\n",
    "                    \"frame_num\": idx_num + 1,\n",
    "                    \"frame_idx\": int(frame_idx),\n",
    "                    \"timestamp_sec\": round(frame_idx / fps, 2),\n",
    "                    \"face_detected\": False,\n",
    "                    \"box_str\": \"Duplicate (Read Error)\"\n",
    "                })\n",
    "            continue\n",
    "\n",
    "        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n",
    "        faces = face_cascade.detectMultiScale(\n",
    "            gray,\n",
    "            scaleFactor=1.1,\n",
    "            minNeighbors=5,\n",
    "            minSize=(30, 30)\n",
    "        )\n",
    "\n",
    "        face_detected = False\n",
    "        if len(faces) > 0:\n",
    "            face_detected = True\n",
    "            faces_detected_count += 1\n",
    "            # Chọn khuôn mặt có diện tích lớn nhất\n",
    "            x, y, w, h = max(faces, key=lambda rect: rect[2] * rect[3])\n",
    "\n",
    "            pad_x = int(0.1 * w)\n",
    "            pad_y = int(0.1 * h)\n",
    "\n",
    "            x1 = max(0, x - pad_x)\n",
    "            y1 = max(0, y - pad_y)\n",
    "            x2 = min(frame.shape[1], x + w + pad_x)\n",
    "            y2 = min(frame.shape[0], y + h + pad_y)\n",
    "\n",
    "            face = frame[y1:y2, x1:x2]\n",
    "            box_str = f\"({x1},{y1})-({x2},{y2})\"\n",
    "        else:\n",
    "            face = frame\n",
    "            box_str = \"Full Frame\"\n",
    "\n",
    "        face_rgb = cv2.cvtColor(face, cv2.COLOR_BGR2RGB)\n",
    "        face_resized = cv2.resize(face_rgb, image_size)\n",
    "\n",
    "        tensor_frame = val_transform(face_resized)\n",
    "\n",
    "        raw_frames.append(face_resized)\n",
    "        processed_tensors.append(tensor_frame)\n",
    "        frame_info_list.append({\n",
    "            \"frame_num\": idx_num + 1,\n",
    "            \"frame_idx\": int(frame_idx),\n",
    "            \"timestamp_sec\": round(frame_idx / fps, 2),\n",
    "            \"face_detected\": face_detected,\n",
    "            \"box_str\": box_str\n",
    "        })\n",
    "\n",
    "    cap.release()\n",
    "\n",
    "    if len(raw_frames) == 0:\n",
    "        raise ValueError(\"Không thể trích xuất khung hình từ video.\")\n",
    "\n",
    "    while len(raw_frames) < sequence_length:\n",
    "        raw_frames.append(raw_frames[-1].copy())\n",
    "        processed_tensors.append(processed_tensors[-1])\n",
    "        frame_info_list.append({\n",
    "            \"frame_num\": len(raw_frames),\n",
    "            \"frame_idx\": 0,\n",
    "            \"timestamp_sec\": 0.0,\n",
    "            \"face_detected\": False,\n",
    "            \"box_str\": \"Padding Last\"\n",
    "        })\n",
    "\n",
    "    raw_frames = raw_frames[:sequence_length]\n",
    "    processed_tensors = processed_tensors[:sequence_length]\n",
    "    frame_info_list = frame_info_list[:sequence_length]\n",
    "\n",
    "    # Tensor Shape: (1, 16, 3, 224, 224)\n",
    "    video_tensor = torch.stack(processed_tensors, dim=0).unsqueeze(0)\n",
    "\n",
    "    meta = {\n",
    "        \"total_frames_in_video\": total_frames,\n",
    "        \"fps\": round(fps, 2),\n",
    "        \"faces_detected_count\": faces_detected_count,\n",
    "        \"face_detection_rate\": round((faces_detected_count / sequence_length) * 100, 1)\n",
    "    }\n",
    "\n",
    "    return video_tensor, np.array(raw_frames), frame_info_list, meta"
   ]
  },
